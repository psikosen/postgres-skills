# ~/.claude/pg.env — Postgres environment registry for the Postgres toolkit.
# Copy this file to ~/.claude/pg.env, chmod 600 it, and define one function per
# environment. The toolkit scripts (psql-ro.sh / explain.sh / health.sh) call
# pg_env_<name> to populate the standard PG* variables just-in-time, so secrets
# can be fetched on demand instead of stored here.
#
# NEVER commit your real pg.env anywhere.

# --- Static credentials (fine for a local/dev database) ---------------------
pg_env_local() {
  export PGHOST=localhost
  export PGPORT=5432
  export PGDATABASE=app
  export PGUSER=postgres
  export PGPASSWORD=postgres
  export PGSSLMODE=disable
}

# --- Fetched on demand (recommended for shared environments) ----------------
# Example: Azure Key Vault holding a "Host=...;Database=...;Username=...;Password=..."
# connection string (the az CLI must already be logged in).
pg_env_dev() {
  local conn
  conn="$(az keyvault secret show --vault-name YOUR-KV-NAME \
          --name YOUR-CONN-SECRET-NAME --query value -o tsv)"
  export PGHOST="$(echo "$conn"     | tr ';' '\n' | grep -i '^Host='     | cut -d= -f2)"
  export PGDATABASE="$(echo "$conn" | tr ';' '\n' | grep -i '^Database=' | cut -d= -f2)"
  export PGUSER="$(echo "$conn"     | tr ';' '\n' | grep -i '^Username=' | cut -d= -f2)"
  export PGPASSWORD="$(echo "$conn" | tr ';' '\n' | grep -i '^Password=' | cut -d= -f2-)"
  export PGSSLMODE=require
}

# Add more: pg_env_beta, pg_env_uat, ... (readonly replica endpoints preferred
# where they exist — the scripts enforce a read-only session either way).

# --- Toolkit maintenance (used by /pg-toolkit) -------------------------------
# Absolute path to your clone of the setup-guide repo, so the maintenance skill
# can run git pull / install.sh --check without asking.
export PG_TOOLKIT_REPO="$HOME/Documents/Postgres"
